---
import DescriptionText from "../../components/DescriptionText.astro";
import { getActivitySections } from "../../lib/activitySections";
import type { CVData } from "../../lib/cvSchema";
import type { DotcvConfig } from "../../lib/configSchema";
import { getTranslations } from "../../lib/i18n";
import { resolveAsset } from "../../lib/assets";

interface Props {
  data: CVData;
  locale?: string;
  config?: DotcvConfig;
}

const { data, locale = "en", config } = Astro.props;
const { profile, skills, projects, certifications } = data;
const t = getTranslations(locale);

const showAtsButton = config?.pdf?.showAtsButton ?? true;
const showDesignButton = config?.pdf?.showDesignButton ?? true;
const showActionBar = showAtsButton || showDesignButton;

const activitySections = getActivitySections(data, t("present"));
---

<div class="cv-classic">
  <!-- Actions Toolbar -->
  {showActionBar && (
    <div class="actions-bar">
      {showAtsButton && (
        <button type="button" class="pdf-btn pdf-btn-primary" data-print-pdf="ats" aria-label="Download ATS PDF" title="ATS-friendly resume for job applications">
          {t("downloadAtsPdf")}
        </button>
      )}
      {showDesignButton && (
        <button type="button" class="pdf-btn pdf-btn-secondary" data-print-pdf="design" aria-label="Download Design PDF" title="Visual portfolio PDF matching current theme">
          {t("downloadDesignPdf")}
        </button>
      )}
    </div>
  )}

  <!-- Header / Profile -->
  <header class="header">
    <div class="header-main">
      {profile.avatar && (
        <div class="avatar-container">
          <img src={resolveAsset(profile.avatar)} alt={profile.name} class="avatar" />
        </div>
      )}
      <div class="profile-info">
        <h1 class="name">{profile.name}</h1>
        <p class="title">{profile.title}</p>
        
        <div class="contact-list">
          {profile.email && (
            <a href={`mailto:${profile.email}`} class="contact-item">
              <span class="icon">✉</span> {profile.email}
            </a>
          )}
          {profile.phone && (
            <a href={`tel:${profile.phone}`} class="contact-item">
              <span class="icon">☎</span> {profile.phone}
            </a>
          )}
          {profile.location && (
            <span class="contact-item">
              <span class="icon">📍</span> {profile.location}
            </span>
          )}
          {profile.website && (
            <a href={profile.website} target="_blank" rel="noopener noreferrer" class="contact-item">
              <span class="icon">🌐</span> {profile.website.replace(/^https?:\/\//, '')}
            </a>
          )}
        </div>

        {profile.socials && profile.socials.length > 0 && (
          <div class="social-links">
            {profile.socials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-link">
                {social.plattform} {social.username ? `(@${social.username})` : ''}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    {profile.bio && (
      <div class="bio">
        <p><DescriptionText text={profile.bio} /></p>
      </div>
    )}
  </header>

  <!-- Activities -->
  {activitySections.map((group) => group.entries.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t(group.key)}</h2>
      <div class="entry-list">
        {group.entries.map((item) => (
          <article class="item">
            <div class="item-header">
              <div>
                <h3 class="item-title">{item.heading}</h3>
                {(item.subtitle || item.location) && <div class="item-subtitle">
                  <span class="entry-subtitle">{item.subtitle}</span>
                  {item.location && <span class="dot">•</span>}
                  {item.location && <span class="location">{item.location}</span>}
                </div>}
              </div>
              {item.period && <div class="date-badge">{item.period}</div>}
            </div>

            {item.description && <p class="item-desc"><DescriptionText text={item.description} /></p>}

            {item.highlights && item.highlights.length > 0 && (
              <ul class="highlights">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}

            {item.technologies && item.technologies.length > 0 && (
              <div class="tags">
                {item.technologies.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <!-- Projects -->
  {projects && projects.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t("projects")}</h2>
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-header">
              <h3 class="item-title">
                {project.url ? (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link">
                    {project.title} ↗
                  </a>
                ) : (
                  project.title
                )}
              </h3>
            </div>
            {project.description && <p class="item-desc"><DescriptionText text={project.description} /></p>}
            {project.highlights && project.highlights.length > 0 && (
              <ul class="highlights">
                {project.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            )}
            {project.technologies && project.technologies.length > 0 && (
              <div class="tags">
                {project.technologies.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Skills -->
  {skills && skills.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t("skills")}</h2>
      <div class="skills-wrapper">
        {skills.map((skillGroup) => (
          <div class="skill-category">
            <h3 class="skill-category-title">{skillGroup.category}</h3>
            <div class="tags">
              {skillGroup.skills.map((skill) => (
                <span class="tag tag-skill">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Certifications -->
  {certifications && certifications.length > 0 && (
    <section class="section certifications-section">
      <h2 class="section-title">{t("certifications")}</h2>
      <ul class="cert-list">
        {certifications.map((cert) => (
          <li class="cert-item">
            <div class="cert-header">
              {cert.url ? (
                <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-link">
                  <strong>{cert.title}</strong> ↗
                </a>
              ) : (
                <strong>{cert.title}</strong>
              )}
              <span class="cert-date">{cert.date}</span>
            </div>
            <div class="cert-issuer">{cert.issuer}</div>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
  :root {
    --cv-color-bg: #ffffff;
    --cv-color-surface: #f8fafc;
    --cv-color-surface-hover: #f1f5f9;
    --cv-color-text: #0f172a;
    --cv-color-text-muted: #64748b;
    --cv-color-border: #e2e8f0;
    --cv-color-accent: #2563eb;
    --cv-color-accent-soft: #eff6ff;
  }

  .cv-classic {
    /* Keep the font local so other themes cannot override it on :root. */
    --cv-font-sans: "Noto Sans JP", "Hiragino Sans", "Yu Gothic", Meiryo, system-ui, sans-serif;
    font-family: var(--cv-font-sans);
    color: var(--cv-color-text);
    background-color: var(--cv-color-bg);
    max-width: 820px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    line-height: 1.6;
  }

  .actions-bar {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    font-size: 0.825rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pdf-btn-primary {
    background-color: var(--cv-color-accent);
    color: #ffffff;
    border: 1px solid var(--cv-color-accent);
  }

  .pdf-btn-primary:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
  }

  .pdf-btn-secondary {
    background-color: var(--cv-color-accent-soft);
    color: var(--cv-color-accent);
    border: 1px solid var(--cv-color-accent);
  }

  .pdf-btn-secondary:hover {
    background-color: #dbeafe;
  }

  /* Header */
  .header {
    border-bottom: 1px solid var(--cv-color-border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .header-main {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .avatar-container {
    flex-shrink: 0;
  }

  .avatar {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--cv-color-border);
  }

  .profile-info {
    flex-grow: 1;
  }

  .name {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 0.25rem 0;
    color: var(--cv-color-text);
  }

  .title {
    font-size: 1.15rem;
    color: var(--cv-color-accent);
    font-weight: 500;
    margin: 0 0 1rem 0;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-size: 0.9rem;
    color: var(--cv-color-text-muted);
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
    transition: color 0.15s ease;
  }

  .contact-item:hover {
    color: var(--cv-color-accent);
  }

  .icon {
    font-size: 0.95rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .social-link {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--cv-color-accent);
    background-color: var(--cv-color-accent-soft);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .social-link:hover {
    background-color: #dbeafe;
  }

  .bio {
    margin-top: 1.25rem;
    color: var(--cv-color-text-muted);
    font-size: 0.975rem;
  }

  /* Section Common */
  .section {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--cv-color-accent);
    border-bottom: 2px solid var(--cv-color-accent-soft);
    padding-bottom: 0.4rem;
    margin: 0 0 1.25rem 0;
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .item-title {
    font-size: 1.075rem;
    font-weight: 700;
    margin: 0;
    color: var(--cv-color-text);
  }

  .item-subtitle {
    font-size: 0.95rem;
    color: var(--cv-color-text-muted);
    margin-top: 0.15rem;
  }

  .entry-subtitle {
    font-weight: 500;
  }

  .dot {
    margin: 0 0.35rem;
  }

  .date-badge {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--cv-color-text-muted);
    white-space: nowrap;
  }

  .item-desc {
    font-size: 0.925rem;
    margin: 0;
    color: var(--cv-color-text);
  }

  .highlights {
    margin: 0.25rem 0 0 0;
    padding-left: 1.25rem;
    font-size: 0.9rem;
    color: var(--cv-color-text-muted);
  }

  .highlights li {
    margin-bottom: 0.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .tag {
    font-size: 0.775rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background-color: var(--cv-color-surface);
    border: 1px solid var(--cv-color-border);
    color: var(--cv-color-text-muted);
  }

  .tag-skill {
    font-size: 0.85rem;
    padding: 0.25rem 0.65rem;
    background-color: var(--cv-color-surface);
    color: var(--cv-color-text);
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .project-card {
    padding: 1.25rem;
    border: 1px solid var(--cv-color-border);
    border-radius: 8px;
    background-color: var(--cv-color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-link {
    color: var(--cv-color-accent);
    text-decoration: none;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  /* Skills */
  .skills-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skill-category-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.4rem 0;
    color: var(--cv-color-text);
  }

  /* Certifications */
  .certifications-section {
    width: 100%;
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cert-item {
    font-size: 0.9rem;
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cert-link {
    color: var(--cv-color-accent);
    text-decoration: none;
  }

  .cert-date {
    font-size: 0.8rem;
    color: var(--cv-color-text-muted);
  }

  .cert-issuer {
    font-size: 0.85rem;
    color: var(--cv-color-text-muted);
  }

  @media (max-width: 640px) {
    .header-main {
      flex-direction: column;
      text-align: center;
    }
    .contact-list {
      justify-content: center;
    }
    .social-links {
      justify-content: center;
    }
    .item-header {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
